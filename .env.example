# Copy to .env for local dev (`npm run dev`). In production set each of these
# with `npx wrangler secret put NAME`. Non-secret settings live in wrangler.jsonc.

# Owner-held password required before anyone can sign in.
ACCESS_PASSWORD=
# Random 32+ character string that signs session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Google OAuth "Web application" client id.
GOOGLE_CLIENT_ID=

# Model provider keys — set the one(s) you use. LLM_API_KEY overrides both,
# for other OpenAI-compatible hosts (OpenRouter, Gemini, ...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# Local only: allow password-only sign-in without Google. Never set in production.
DEV_AUTH=
