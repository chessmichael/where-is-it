# Copy to .env for local dev (`npm run dev`). In production set each of these
# with `npx wrangler secret put NAME`. Non-secret settings live in wrangler.jsonc.

# Owner-held password required to create an account (then passkeys take over).
ACCESS_PASSWORD=
# Random 32+ character string that signs session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Model provider keys — set the one(s) you use. LLM_API_KEY overrides both,
# for other OpenAI-compatible hosts (OpenRouter, Gemini, ...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# Local only: allow password-only sign-in without a passkey. Never set in production.
DEV_AUTH=

# AWS Bedrock (LLM_PROVIDER=bedrock, LLM_MODEL=<model or inference-profile id>).
# Create a key in the Bedrock console → API keys.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Optional cheaper model for short, plain turns ("the drill is in the garage", "where's my passport?").
# Positions, stacks, long descriptions, answers to questions and all tidy-up stay on LLM_MODEL.
LLM_FAST_MODEL=
LLM_FAST_PROVIDER=
