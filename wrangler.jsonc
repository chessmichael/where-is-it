// Cloudflare Worker: serves the PWA (static assets) and the /api backend.
// Secrets (set with `npx wrangler secret put NAME`, or in .env for local dev):
//   ACCESS_PASSWORD   - owner-held password required to create an account
//   SESSION_SECRET    - random string used to sign session cookies
//   OPENAI_API_KEY / ANTHROPIC_API_KEY / LLM_API_KEY - whichever provider is used
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-is-it",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://where-is-it.YOUR-SUBDOMAIN.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOUSE", "class_name": "HouseDO" },
      { "name": "AUTH", "class_name": "AuthDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HouseDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AuthDO"] }
  ],
  // Sign-in / sign-up attempts per IP per minute.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Which model backs the agent. Swap without code changes:
    //   LLM_PROVIDER = "anthropic" | "openai"   ("openai" = any OpenAI-compatible API)
    //   LLM_MODEL    = model id for that provider
    //   LLM_BASE_URL = optional, for OpenAI-compatible hosts (Ollama, OpenRouter, Gemini, ...)
    "LLM_PROVIDER": "openai",
    "LLM_MODEL": "",
    "LLM_BASE_URL": ""
  },
  "observability": { "enabled": true }
}
