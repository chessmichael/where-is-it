// Cloudflare Worker: serves the PWA (static assets) and the /api backend.
// Secrets (set with `npx wrangler secret put NAME`, or in .env for local dev):
//   ACCESS_PASSWORD   - owner-held password required to sign in at all
//   SESSION_SECRET    - random string used to sign session cookies
//   GOOGLE_CLIENT_ID  - OAuth web client id (not secret, but kept with the rest)
//   OPENAI_API_KEY / ANTHROPIC_API_KEY / LLM_API_KEY - whichever provider is used
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-is-it",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HOUSE", "class_name": "HouseDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseDO"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "where-is-it-files" }],
  // Sign-in attempts per IP per minute.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Which model backs the agent. Swap without code changes:
    //   LLM_PROVIDER = "anthropic" | "openai"   ("openai" = any OpenAI-compatible API)
    //   LLM_MODEL    = model id for that provider
    //   LLM_BASE_URL = optional, for OpenAI-compatible hosts (Ollama, OpenRouter, Gemini, ...)
    "LLM_PROVIDER": "openai",
    "LLM_MODEL": "",
    "LLM_BASE_URL": "",
    // Optional comma-separated allowlist of Google emails ("" = anyone who has the password).
    "ALLOWED_EMAILS": ""
  },
  "observability": { "enabled": true }
}
