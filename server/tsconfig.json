{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./test/**"
  ]
}
